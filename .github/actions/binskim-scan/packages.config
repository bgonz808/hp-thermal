<?xml version="1.0" encoding="utf-8"?>
<!-- #226: Dependabot-visible declaration of the BinSkim version (nuget ecosystem watches this
     file). The composite action parses the version from HERE (single source); the sha256 pin in
     action.yml remains the execution authorization. On a Dependabot version bump the digest
     intentionally mismatches until a human verifies + updates it — fail-closed by design. -->
<packages>
  <package id="Microsoft.CodeAnalysis.BinSkim" version="4.4.9.11" />
</packages>
