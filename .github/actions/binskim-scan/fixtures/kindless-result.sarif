{
  "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
  "version": "2.1.0",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "binskim-scan self-test fixture (#385)",
          "rules": [
            { "id": "BA2001", "name": "LoadImageAboveFourGigabyteAddress",
              "messageStrings": { "Pass": { "text": "'{0}' is a 64-bit image with a preferred base address above the 4GB boundary." } } },
            { "id": "BA2024", "name": "EnableSpectreMitigations",
              "messageStrings": { "Warning": { "text": "'{0}' was compiled with one or more modules that do not enable Spectre mitigations: {1}" } } }
          ]
        }
      },
      "invocations": [ { "executionSuccessful": true } ],
      "results": [
        { "ruleId": "BA2001", "ruleIndex": 0, "kind": "pass", "level": "none",
          "message": { "id": "Pass", "arguments": [ "fixture.exe" ] } },
        { "ruleId": "BA2024", "ruleIndex": 1,
          "message": { "id": "Warning", "arguments": [ "fixture.exe", "libcmt.lib,cxx,19.50.35721.0 (exe_main.obj)" ] } },
        { "ruleId": "BA2001", "ruleIndex": 0, "kind": "notApplicable", "level": "none",
          "message": { "text": "not applicable on this image" } }
      ]
    }
  ]
}
